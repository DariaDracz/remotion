{
  "name": "ilt-reels",
  "version": "1.0.0",
  "private": true,
  "description": "Szablon produkcyjny rolek Kancelarii ILT",
  "scripts": {
    "start": "remotion studio src/index.ts --no-open",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "render": "npm run validate -- config/reel.json && remotion render src/index.ts ILT-Reel out/ilt-reel.mp4 --codec=h264 --pixel-format=yuv420p",
    "still": "remotion still src/index.ts ILT-Reel out/cover.png --frame=30",
    "validate": "node --import tsx scripts/validate.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/league-spartan": "5.2.7",
    "@fontsource/montserrat": "5.2.8",
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/media": "4.0.535",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.535",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
